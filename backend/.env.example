# --- App ---
ENVIRONMENT=development            # development | testing | production
ENABLE_DOCS=true                   # set false in production if you do not want /docs
FRONTEND_ORIGINS=http://localhost:5173   # comma-separated, exact origins, never "*"

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=adtu_notes

# --- JWT / cookies ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=                     # blank = auto (true in production). Must be true if SAMESITE=none
COOKIE_SAMESITE=lax                # lax | strict | none (none only for cross-site frontend, needs HTTPS)
COOKIE_DOMAIN=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=adtu-notes/notes
MAX_UPLOAD_SIZE_MB=10
MAX_SEMESTERS=8

# --- Abuse protection ---
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false          # true only behind a reverse proxy you control

# --- Admin bootstrap (used ONLY by: python -m scripts.create_admin) ---
ADMIN_NAME=Site Administrator
ADMIN_USERNAME=siteadmin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-Strong-Passw0rd
